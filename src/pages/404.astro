---
import BookLayout from '../layouts/BookLayout.astro';
import Icon from '../components/Icon.astro';
import { homeUrl } from '../lib/book';
---
<BookLayout title="这一页还没有写下"><div class="not-found"><span>404</span><h1>翻过了最后一页。</h1><p>这个地址没有对应的章节，可以回到目录继续读。</p><a class="primary-button" href={homeUrl()}>回到书的首页<Icon name="arrow" size={17} /></a></div></BookLayout>
